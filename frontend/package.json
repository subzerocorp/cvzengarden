{
  "name": "resumezen-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "node scripts/generate.mjs",
    "build": "npm run gen && elm make src/Main.elm --output=dist/garden.js && node scripts/copy-dist.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "probe": "npm run build && node scripts/probes.mjs",
    "test": "npm run probe"
  },
  "devDependencies": {
    "elm": "^0.19.1-6",
    "playwright": "^1.56.1"
  }
}

# Server port (never hard-code 4173; it is often taken locally)
PORT=4310
# libSQL URL. Local file for `just serve`; on Cloudflare Workers a Turso libsql:// URL
# set with `wrangler secret put DATABASE_URL` (see .dev.vars for `just worker`).
DATABASE_URL=file:data/cvzengarden.sqlite
# Turso auth token (production only)
# DATABASE_AUTH_TOKEN=
# Seed the three review-queue examples when the store has no submissions (1 = on)
RZ_SEED_DEMO=1
# Reviewer token for the moderation API and the /admin page (moderation is off when unset)
RZ_ADMIN_TOKEN=garden-dev
